# ============================================
# Dockerfile para TileServer GL con datos de Cuba
# ============================================

FROM maptiler/tileserver-gl:latest

# Cambiar a root para instalar paquetes y modificar
USER root

# Instalar curl
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copiar el script de inicio personalizado
COPY start-tileserver.sh /start.sh
RUN chmod +x /start.sh

# Volver al directorio de la app
WORKDIR /usr/src/app

# Exponer puerto
EXPOSE 8080

# Comando de inicio
CMD ["/start.sh"]
