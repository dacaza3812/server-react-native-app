# ============================================
# Dockerfile para TileServer GL con datos de Cuba
# ============================================

FROM maptiler/tileserver-gl:latest

# Instalar herramientas necesarias
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Crear directorio de datos
WORKDIR /data

# Script de inicio que descarga Cuba si no existe
RUN echo '#!/bin/sh\n\
cd /data\n\
if [ ! -f cuba.mbtiles ]; then\n\
    echo "⬇️ Descargando datos de Cuba..."\n\
    curl -L -o cuba.mbtiles "https://geodata.maptiler.download/extracts/osm/v3.11/2020-02-10/central-america/osm-2020-02-10-v3.11_central-america_cuba.mbtiles"\n\
    echo "✅ Datos de Cuba descargados"\n\
fi\n\
echo "🚀 Iniciando TileServer con datos de Cuba..."\n\
exec tileserver-gl --port 8080 /data/cuba.mbtiles\n\
' > /start.sh && chmod +x /start.sh

# Exponer puerto
EXPOSE 8080

# Comando de inicio
CMD ["/start.sh"]
