# ============================================
# Dockerfile para TileServer GL con datos de Cuba
# ============================================

FROM maptiler/tileserver-gl:latest

# Cambiar a root para instalar paquetes
USER root

# Instalar herramientas necesarias
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Crear directorio de datos
WORKDIR /data

# Crear el script de inicio
COPY start-tileserver.sh /start.sh
RUN chmod +x /start.sh

# Volver al usuario original (node)
USER node

# Exponer puerto
EXPOSE 8080

# Comando de inicio
CMD ["/start.sh"]
